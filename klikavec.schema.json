{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Klikavec Home configuration v1",
  "description": "Extension of GarminHomeAssistant title/items JSON. Local private configuration; no credentials.",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 64
    },
    "version": {
      "const": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "$ref": "#/$defs/color"
        },
        "warning": {
          "$ref": "#/$defs/color"
        },
        "error": {
          "$ref": "#/$defs/color"
        },
        "info": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entity": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "maxLength": 100
    },
    "writable": {
      "enum": [
        "light.led_pasek",
        "light.zvonek_panel_podsviceni",
        "switch.zasuvka_venku",
        "switch.0xa4c13800486fffff",
        "switch.0xa4c138bb867ffa04",
        "switch.zasuvka_1"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "items"
      ],
      "properties": {
        "type": {
          "const": "group"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "title": {
          "$ref": "#/$defs/name"
        },
        "visible": {
          "type": "boolean"
        },
        "home": {
          "type": "boolean"
        },
        "icon": {
          "enum": [
            "home",
            "power",
            "temperature",
            "network",
            "leaf",
            "settings",
            "warning"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "$ref": "#/$defs/subgroup"
              }
            ]
          }
        }
      }
    },
    "subgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "items"
      ],
      "properties": {
        "type": {
          "const": "group"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "title": {
          "$ref": "#/$defs/name"
        },
        "icon": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "row": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "entity"
          ],
          "properties": {
            "type": {
              "enum": [
                "info",
                "toggle"
              ]
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "entity": {
              "$ref": "#/$defs/entity"
            },
            "humidity": {
              "$ref": "#/$defs/entity"
            },
            "unit": {
              "type": "string",
              "maxLength": 8
            },
            "confirm": {
              "type": "boolean"
            },
            "favorite": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "connectivity",
                "heating",
                "health"
              ]
            },
            "maxAge": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800
            },
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "minValid": {
              "type": "number"
            },
            "maxValid": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "toggle"
                  }
                }
              },
              "then": {
                "properties": {
                  "entity": {
                    "$ref": "#/$defs/writable"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "entity": {
                    "const": "switch.zasuvka_1"
                  }
                }
              },
              "then": {
                "properties": {
                  "favorite": {
                    "const": false
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "target"
          ],
          "properties": {
            "type": {
              "const": "link"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "target": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "enum": [
                "refresh",
                "config",
                "about"
              ]
            },
            "name": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    }
  }
}
